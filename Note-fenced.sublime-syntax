    - include: fenced-sql
    - include: fenced-stata
    - include: fenced-tex
    - include: fenced-xml
    - include: fenced-yaml
    - include: fenced-undefined
  fenced-undefined:
    - match: '((?:^|\G)\s*[`~]{3,})\s*(.+?)?\s*$'
      captures:
        1: punctuation.definition.raw.block.fenced.markdown
      push:
        - meta_scope: markup.raw.block.markdown markup.raw.block.fenced.markdown
        - match: '^(\1)[ \t]*(\n|$)'
          captures:
            1: punctuation.definition.raw.block.fenced.markdown
          pop: true
  fenced-c:
    - match: '((?:^|\G)\s*[`~]{3,})\s*(c)\s*$'
      captures:
        1: punctuation.definition.raw.block.fenced.markdown
        2: meta.definition.language.raw.block.fenced.markdown
      embed: scope:source.c
      embed_scope: markup.raw.block.markdown markup.raw.block.fenced.markdown meta.language.c source.c
      escape: '^(\1)[ \t]*(\n|$)'
      escape_captures:
        1: punctuation.definition.raw.block.fenced.markdown
