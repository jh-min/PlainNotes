%YAML 1.2
---
name: "-"
scope: text.html.markdown.note.fenced
contexts:
  main:
    - include: fenced-code-blocks
  fenced-code-blocks:
    - include: fenced-c
    - include: fenced-c++
    - include: fenced-coffee
    - include: fenced-css
    - include: fenced-diff
    - include: fenced-erlang
    - include: fenced-go
    - include: fenced-haskell
    - include: fenced-html
    - include: fenced-java
    - include: fenced-js
